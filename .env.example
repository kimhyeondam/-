# 내 컴퓨터에서 실행할 때 쓰는 설정. 이 파일을 복사해 .env.local 을 만들고 값을 채웁니다. (운영 서버는 .env.production.example 참고)
AUTH_SECRET=여기에-길고-복잡한-비밀키를-넣으세요
ADMIN_ID=admin
ADMIN_PASSWORD=hyundam1234

# AI 비서(현담비서)를 Claude에 연결하려면 Anthropic API 키를 넣으세요. 없으면 내장 비서가 동작합니다.
ANTHROPIC_API_KEY=

# 데이터 저장소
# - 비워 두면 서버의 data 폴더에 파일로 저장합니다. (한 대의 서버에서 쓸 때)
# - PostgreSQL 주소를 넣으면 데이터베이스에 저장합니다. (Vercel/Supabase/Neon 등)
DATABASE_URL=
# 파일 저장 폴더를 바꾸고 싶을 때만 (기본: ./data)
DATA_DIR=

# 관급 발주 현황: 공공데이터포털(data.go.kr) 「조달청_나라장터 입찰공고정보서비스」 일반 인증키(Decoding)
DATA_GO_KR_KEY=

# 관급 발주 지역: jb = 전북 (기본), gj = 광주·전남
BID_REGION=jb

# 첫 실행 준비 (처음 켤 때 한 번만 적용)
# 회사 이름·약칭. 비워 두면 「현담토목 / 현담」(비서 이름은 「약칭+비서」)
COMPANY_NAME=현담토목
COMPANY_SHORT=현담
# 1 이면 예시 자료 없이 빈 상태로 시작 (기본). 화면 모양을 예시 자료로 먼저 보려면 0
FRESH_START=1
