# 서버용 환경 변수. 이 파일을 복사해 .env.production 으로 만들고 값을 채우세요.
# (docker compose 가 자동으로 읽습니다. bash deploy/setup.sh 가 처음 한 번 자동으로 복사해 줍니다)

# 접속 주소 (도메인). 예: work.hyundam.co.kr  — 도메인이 아직 없으면 서버IP.sslip.io 형식도 가능 (예: 1.2.3.4.sslip.io)
# 주소를 여러 개 쓰려면 쉼표로 이어 적습니다. 예: DOMAIN=work.hyundam.co.kr, work.hyundam.com
DOMAIN=work.example.com

# 로그인 출입증 서명용 비밀키. 아래 명령으로 만든 긴 무작위 문자열을 넣으세요:  openssl rand -hex 32  (setup.sh 가 자동으로 채웁니다)
AUTH_SECRET=

# 첫 실행 때 만들어지는 관리자 계정
ADMIN_ID=admin
ADMIN_PASSWORD=바꿔주세요

# AI 비서·명함 인식·회의록 정리용 (없으면 내장 비서만 동작)
ANTHROPIC_API_KEY=

# PostgreSQL 을 쓸 때만 (비우면 data/ 폴더에 파일로 저장)
DATABASE_URL=

# 관급 발주 현황: 공공데이터포털(data.go.kr) 「조달청_나라장터 입찰공고정보서비스」 일반 인증키(Decoding)
DATA_GO_KR_KEY=

# 관급 발주 지역: jb = 전북 (기본), gj = 광주·전남
BID_REGION=jb

# ── 첫 실행 준비 (처음 켤 때 한 번만 적용) ──
# 회사 이름·약칭. 시스템 설정에 회사가 없을 때 자동으로 넣습니다 (비서 이름은 「약칭+비서」)
COMPANY_NAME=현담토목
COMPANY_SHORT=현담
# 1 이면 예시 자료·예시 직원 계정 없이 빈 상태로 시작합니다 (관리자 계정 하나만 만들어짐). 0 이면 화면 확인용 예시 자료가 들어갑니다
FRESH_START=1
